[Unit]
Description=Nemotron Nano 9B v2 Q4_K_M OpenAI-compatible endpoint
After=network-online.target dflash2.service
Conflicts=dflash2.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/usr/local/lib/ollama:/usr/local/lib/ollama/cuda_v13:/usr/lib/wsl/lib
Environment=GGML_BACKEND_PATH=/usr/local/lib/ollama/cuda_v13/libggml-cuda.so
ExecStart=/usr/local/lib/ollama/llama-server -m /path/to/data/gpustation-models/nemotron/nvidia_NVIDIA-Nemotron-Nano-9B-v2-Q4_K_M.gguf --alias nemotron-nano-9b-v2 --host 127.0.0.1 --port 18083 -c 16384 -np 1 -ngl all --fit off -fa on -ctk q8_0 -ctv q8_0 -b 512 -ub 128 --jinja --reasoning-format deepseek --metrics --cache-ram 0 --load-mode dio --temp 0.6 --top-p 0.95 --api-key-file /path/to/remote-home/.config/dflash2/api-key
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=default.target
